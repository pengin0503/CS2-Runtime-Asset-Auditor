<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>CS2RuntimeAssetAuditor</RootNamespace>
    <AssemblyName>CS2RuntimeAssetAuditor</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Import Project="$(CSII_TOOLPATH)\Mod.props" />
  <Import Project="$(CSII_TOOLPATH)\Mod.targets" />

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.PSI.Common"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="Unity.Profiling.Core"><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Runtime.Serialization"><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="VerifyHarmonyRuntimeWasCopied" AfterTargets="Build">
    <Error Condition="!Exists('$(TargetDir)0Harmony.dll')"
           Text="The required private 0Harmony.dll runtime was not copied to the mod output." />
  </Target>

  <!--
    The UI bundle is part of the mod: without CS2RuntimeAssetAuditor.mjs the game loads the DLL but shows no
    launcher. Resolve the UI project from this file (SolutionDir is "*Undefined*" when the project is built
    directly), build the bundle into the mod output before the toolchain's DeployWIP copies that output to the
    local Mods folder, and fail the build when any shipped UI file is missing.
  -->
  <PropertyGroup>
    <ModUiProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'UI'))</ModUiProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <ModUiRequiredFile Include="$(AssemblyName).mjs" />
    <ModUiRequiredFile Include="$(AssemblyName).css" />
    <ModUiRequiredFile Include="cs2-runtime-asset-auditor-images\profiler-icon.svg" />
  </ItemGroup>

  <Target Name="BuildUI" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
    <Error Condition="!Exists('$(ModUiProjectDir)package.json')"
           Text="The UI project was not found at $(ModUiProjectDir)." />
    <Error Condition="!Exists('$(ModUiProjectDir)node_modules')"
           Text="UI dependencies are not installed. Run 'npm ci' in $(ModUiProjectDir) before building the mod." />
    <Exec Command="npm run build" WorkingDirectory="$(ModUiProjectDir)"
          EnvironmentVariables="CS2_MOD_UI_OUTPUT_DIR=$(TargetDir)" />
    <Error Condition="!Exists('$(TargetDir)%(ModUiRequiredFile.Identity)')"
           Text="The UI build did not produce %(ModUiRequiredFile.Identity) in the mod output $(TargetDir)." />
  </Target>
</Project>
